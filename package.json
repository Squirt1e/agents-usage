{
  "name": "agents-usage-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev:desktop": "npm run dev:desktop-host",
    "dev:service": "bash tools/cargo.sh run -p usage-service",
    "dev:desktop-web": "node scripts/desktop/dev-web.mjs",
    "dev:desktop-host": "bash tools/cargo.sh build -p usage-service && bash tools/tauri.sh dev --config src-tauri/tauri.dev.conf.json",
    "build": "npm run build:server && npm run build:client && npm run build:desktop-web",
    "build:server": "tsup src/server/index.ts --format esm --platform node --target node24 --out-dir dist/server --clean",
    "build:client": "node scripts/clear-dir.mjs dist/client && vite build",
    "build:desktop-web": "node scripts/clear-dir.mjs dist/desktop-client && node scripts/desktop/build-web.mjs",
    "build:desktop": "bash tools/tauri.sh build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/config.test.ts tests/contracts.test.ts tests/persistence.test.ts tests/codex.test.ts tests/glm.test.ts tests/deepseek.test.ts tests/orchestrator.test.ts",
    "test:integration": "vitest run tests/api.test.ts",
    "test:browser": "vitest run tests/dashboard.test.tsx tests/app.test.tsx",
    "test:security": "vitest run tests/security.test.ts",
    "test:e2e": "vitest run tests/e2e.test.ts",
    "test:contracts": "vitest run tests/contracts.test.ts tests/contracts-conformance.test.ts",
    "test:watch": "vitest",
    "rust:check": "bash tools/cargo.sh check --workspace --all-targets",
    "rust:test": "bash tools/cargo.sh test --workspace",
    "rust:fmt": "bash tools/cargo.sh fmt --all",
    "rust:clippy": "bash tools/cargo.sh clippy --workspace --all-targets -- -D warnings",
    "contract:test": "npm run test:contracts && npm run rust:test",
    "verify:legacy": "bash scripts/verify-legacy-web.sh",
    "verify:baseline": "node scripts/verify-baseline.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js}": "eslint --fix"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tauri-apps/cli": "^2.9.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.5.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
